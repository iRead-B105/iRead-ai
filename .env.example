AI_INTERNAL_API_KEY=replace-with-backend-shared-key
APP_ENV=development
# 자동 테스트·로컬 무과금 실행은 mock, GMS 실제 연동은 gms
AI_GENERATION_PROVIDER=mock
# 이야기 개인화 생성도 로컬은 mock, 실제 연동은 gms
STORY_PROVIDER=mock
CHAPTER_CANDIDATE_COUNT=1
GMS_KEY=replace-with-gms-key
GMS_BASE_URL=https://gms.ssafy.io/gmsapi
# 비우면 GMS_BASE_URL/api.openai.com/v1 사용
GMS_OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MAX_OUTPUT_TOKENS=2400
OPENAI_CHAPTER_MAX_OUTPUT_TOKENS=8000
OPENAI_VISUAL_SCENE_MAX_OUTPUT_TOKENS=3200
MODEL_TIMEOUT_SECONDS=75
VISUAL_SCENE_TIMEOUT_SECONDS=8
CHAPTER_CANDIDATE_COUNT=3
AI_GMS_TEXT_TIMEOUT_SECONDS=28
AI_GMS_MAX_OUTPUT_TOKENS=3200
AI_IDEMPOTENCY_TTL_SECONDS=600
# 실제 이야기 이미지 생성은 gemini, 로컬 무과금 실행은 disabled
STORY_IMAGE_PROVIDER=disabled
GMS_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GMS_IMAGE_TIMEOUT_SECONDS=180
GMS_IMAGE_MAX_BYTES=12582912
GMS_IMAGE_MAX_RESPONSE_BYTES=20971520
GMS_IMAGE_MAX_REQUEST_BYTES=20971520
CHARACTER_REFERENCE_DIR=assets/character-references
AI_PRONUNCIATION_PROVIDER=deterministic
AI_SPEECH_PROVIDER=deterministic
AZURE_SPEECH_KEY=replace-with-azure-speech-key
AZURE_SPEECH_REGION=koreacentral
AZURE_SPEECH_LANGUAGE=ko-KR
AZURE_SPEECH_VOICE=ko-KR-SunHiNeural
AI_MAX_AUDIO_BYTES=20971520
