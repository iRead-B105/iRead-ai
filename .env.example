# -----------------------------------------------------------------------------
# 애플리케이션 기본 설정
# -----------------------------------------------------------------------------
APP_ENV=development
AI_INTERNAL_API_KEY=replace-with-backend-shared-key
AI_IDEMPOTENCY_TTL_SECONDS=600

# 비우면 운영체제 임시 폴더에 생성합니다. 영속 보관 시 쓰기 가능한 경로를 지정합니다.
AI_TRAINING_ITEM_DB_PATH=
# 한국어기초사전에서 구축한 AI 서버 소유 어휘·발음·음운 SQLite 경로입니다.
AI_LEXICON_DB_PATH=local-output/lexicon/story-lexicon.sqlite3

# -----------------------------------------------------------------------------
# 공급자 인증 및 API 주소
# -----------------------------------------------------------------------------
# 사용하는 공급자의 키만 입력합니다.
GMS_KEY=replace-with-gms-key
GMS_BASE_URL=https://gms.ssafy.io/gmsapi
# 비우면 GMS_BASE_URL/api.openai.com/v1을 사용합니다.
GMS_OPENAI_BASE_URL=

OPENAI_API_KEY=replace-with-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=replace-with-gemini-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# -----------------------------------------------------------------------------
# 맞춤 훈련·교사 분석 텍스트 생성
# -----------------------------------------------------------------------------
# 허용값: mock, gms, openai
# 허용값: mock, gms, gemini, openai
# Gemini 3.5 Flash-Lite 사용 시 gemini로 설정합니다.
AI_GENERATION_PROVIDER=mock
AI_GMS_TEXT_TIMEOUT_SECONDS=28
AI_GMS_MAX_OUTPUT_TOKENS=3200

# -----------------------------------------------------------------------------
# 이야기 텍스트 생성
# -----------------------------------------------------------------------------
# provider와 model은 이미지 설정과 독립적으로 선택합니다.
# 허용값: mock, gms, gemini, openai
# Gemini 3.5 Flash-Lite 직접 호출 예시:
# STORY_TEXT_PROVIDER=gemini
# STORY_TEXT_MODEL=gemini-3.5-flash-lite
STORY_TEXT_PROVIDER=mock
STORY_TEXT_MODEL=gpt-5.4-mini

MODEL_TIMEOUT_SECONDS=75
OPENAI_MAX_OUTPUT_TOKENS=2400
OPENAI_CHAPTER_MAX_OUTPUT_TOKENS=8000
OPENAI_VISUAL_SCENE_MAX_OUTPUT_TOKENS=3200
VISUAL_SCENE_TIMEOUT_SECONDS=8

# 장 생성 품질 검증 설정
CHAPTER_CANDIDATE_COUNT=3
CHAPTER_QUALITY_RETRY_COUNT=0
CHAPTER_REQUIRE_CONTRACT_PASS=true

# 음성 분기 입력 안전성 검토
AI_BRANCH_REVIEW_MODEL=gpt-5.4-mini
AI_BRANCH_REVIEW_TIMEOUT_SECONDS=3
AI_BRANCH_REVIEW_MAX_OUTPUT_TOKENS=80

# -----------------------------------------------------------------------------
# 이야기 이미지 생성
# -----------------------------------------------------------------------------
# 허용값: disabled, gms, gemini, openai
STORY_IMAGE_PROVIDER=disabled
STORY_IMAGE_MODEL=gemini-2.5-flash-image

# 표지와 캐릭터 참조 이미지 경로
STORY_COVER_DIR=assets/story-covers
CHARACTER_REFERENCE_DIR=assets/character-references

GMS_IMAGE_TIMEOUT_SECONDS=180
GMS_IMAGE_MAX_BYTES=12582912
GMS_IMAGE_MAX_RESPONSE_BYTES=20971520
GMS_IMAGE_MAX_REQUEST_BYTES=20971520

# -----------------------------------------------------------------------------
# 발음 평가·STT·TTS
# -----------------------------------------------------------------------------
# 발음 평가 허용값: azure, gms, deterministic
# azure는 단어별 정확도·유창성 평가, gms는 개발 호환용 STT 일치도,
# deterministic은 계약 테스트용 provider입니다.
AI_PRONUNCIATION_PROVIDER=azure
AI_GMS_SPEECH_MODEL=whisper-1
AI_GMS_SPEECH_TIMEOUT_SECONDS=45

# 음성 합성 허용값: azure, deterministic
AI_SPEECH_PROVIDER=deterministic
AZURE_SPEECH_KEY=replace-with-azure-speech-key
AZURE_SPEECH_REGION=koreacentral
AZURE_SPEECH_LANGUAGE=ko-KR
AZURE_SPEECH_VOICE=ko-KR-SunHiNeural
AI_MAX_AUDIO_BYTES=20971520
